{
  "expo": {
    "name": "Reverie",
    "slug": "reverie",
    "platforms": ["ios", "android", "web"],
    "web": { "bundler": "metro", "output": "single" },
    "version": "4.3.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "reverie",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0F0F12",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "reverie.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSLocalNetworkUsageDescription": "Reverie connects to your model server on your local network.",
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      },
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      }
    },
    "android": {
      "package": "reverie.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-mono.png",
        "backgroundColor": "#0F0F12"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": ["USE_BIOMETRIC", "VIBRATE"],
      "blockedPermissions": ["android.permission.RECORD_AUDIO", "android.permission.SYSTEM_ALERT_WINDOW"]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#F5F5F7",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#0F0F12"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Reverie uses your photos for character avatars and messages.",
          "cameraPermission": "Reverie uses the camera to send a photo in chat.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Reverie uses your photos for character avatars and messages.",
          "savePhotosPermission": "Reverie saves the pictures you download to Photos.",
          "granularPermissions": ["photo"]
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Reverie uses Face ID to protect your chats."
        }
      ],
      "expo-font",
      "./plugins/android-lint",
      ["expo-build-properties", { "android": { "usesCleartextTraffic": true } }],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "VioletGradient",
            "ios": "./assets/images/alt/icon-02-violet-gradient.png",
            "android": { "foregroundImage": "./assets/images/alt/icon-02-violet-gradient-foreground.png", "backgroundColor": "#6D3FC4" }
          },
          {
            "name": "CoralSunrise",
            "ios": "./assets/images/alt/icon-03-coral-sunrise.png",
            "android": { "foregroundImage": "./assets/images/alt/icon-03-coral-sunrise-foreground.png", "backgroundColor": "#FA7A43" }
          },
          {
            "name": "PaperLight",
            "ios": "./assets/images/alt/icon-04-paper-light.png",
            "android": { "foregroundImage": "./assets/images/alt/icon-04-paper-light-foreground.png", "backgroundColor": "#F5F1EA" }
          },
          {
            "name": "VioletSun",
            "ios": "./assets/images/alt/icon-05-violet-solid-sun.png",
            "android": { "foregroundImage": "./assets/images/alt/icon-05-violet-solid-sun-foreground.png", "backgroundColor": "#8B5CF6" }
          },
          {
            "name": "Outline",
            "ios": "./assets/images/alt/icon-06-outline.png",
            "android": { "foregroundImage": "./assets/images/alt/icon-06-outline-foreground.png", "backgroundColor": "#0B0D17" }
          },
          {
            "name": "NeonGlow",
            "ios": "./assets/images/alt/icon-07-neon-glow.png",
            "android": { "foregroundImage": "./assets/images/alt/icon-07-neon-glow-foreground.png", "backgroundColor": "#0D0A1F" }
          },
          {
            "name": "Metal",
            "ios": "./assets/images/alt/icon-08-metal.png",
            "android": { "foregroundImage": "./assets/images/alt/icon-08-metal-foreground.png", "backgroundColor": "#8A1A5C" }
          },
          {
            "name": "RetroSticker",
            "ios": "./assets/images/alt/icon-09-retro-sticker.png",
            "android": { "foregroundImage": "./assets/images/alt/icon-09-retro-sticker-foreground.png", "backgroundColor": "#FFF1D6" }
          },
          {
            "name": "ToneOnTone",
            "ios": "./assets/images/alt/icon-10-tone-on-tone.png",
            "android": { "foregroundImage": "./assets/images/alt/icon-10-tone-on-tone-foreground.png", "backgroundColor": "#8B5CF6" }
          }
        ]
      ]
    ],
    "locales": {
      "ru": "./permissions/ru.json"
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
