+// A sheet below the full height is interactive Liquid Glass on iOS 26 and later: the whole
+// sheet squeezes and flares under any touch on it. A color effect in place of the glass
+// makes it a plain solid sheet, in the color of what the screen paints, or the system's.
+- (void)setSolidBackgroundForSheet:(UISheetPresentationController *)sheet
+{
+#if RNS_IPHONE_OS_VERSION_AVAILABLE(26_1)
+  if (@available(iOS 26.1, *)) {
+    UIColor *color = [self opaqueContentColorIn:self depth:4] ?: UIColor.systemBackgroundColor;
+    // UIColorEffect does not say its color, so the one set last is kept on the sheet.
+    UIColor *current = objc_getAssociatedObject(sheet, @selector(setSolidBackgroundForSheet:));
+    if (![sheet.backgroundEffect isKindOfClass:UIColorEffect.class] || ![current isEqual:color]) {
+      sheet.backgroundEffect = [UIColorEffect effectWithColor:color];
+      objc_setAssociatedObject(sheet, @selector(setSolidBackgroundForSheet:), color, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+    }
+  }
+#endif
+}
+
+// The first opaque fill as large as the screen in the views under it, what contentStyle sets.
+- (nullable UIColor *)opaqueContentColorIn:(UIView *)view depth:(int)depth
+{
+  CGColorRef cg = view.backgroundColor.CGColor;
+  if (view != self && cg != nil && CGColorGetAlpha(cg) == 1.0 && !CGRectIsEmpty(self.bounds) &&
+      CGSizeEqualToSize(view.bounds.size, self.bounds.size)) {
+    return view.backgroundColor;
+  }
+  if (depth == 0) {
+    return nil;
+  }
+  for (UIView *child in view.subviews) {
+    UIColor *found = [self opaqueContentColorIn:child depth:depth - 1];
+    if (found != nil) {
+      return found;
+    }
+  }
+  return nil;
+}
