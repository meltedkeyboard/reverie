{
  "name": "reverie",
  "version": "6.1.0",
  "private": true,
  "main": "src/index",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "desktop": "node tools/desktop-dev.mjs",
    "desktop:preview": "expo export -p web && electron electron/main.js",
    "desktop:build": "expo export -p web && electron-builder",
    "typecheck": "tsc --noEmit",
    "icons": "node tools/build-icons.mjs",
    "postinstall": "patch-package --patch-dir tools/patches && node tools/build-icons.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@expo/ui": "~58.0.23",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/slider": "5.2.1",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@shopify/flash-list": "2.3.2",
    "base64-js": "^1.5.1",
    "expo": "~58.0.19",
    "expo-alternate-app-icons": "^8.0.0",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.11",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-local-authentication": "~58.0.2",
    "expo-media-library": "~58.0.12",
    "expo-router": "~58.0.26",
    "expo-sensors": "~58.0.4",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-video": "~58.0.12",
    "fflate": "^0.8.3",
    "lucide-react-native": "^1.52.0",
    "marked": "^18.0.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-reorderable-list": "^0.18.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "~19.3.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "build": {
    "appId": "reverie.app",
    "productName": "Reverie",
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "dist/**",
      "package.json"
    ],
    "icon": "assets/images/icon.png",
    "artifactName": "${productName}-${version}.${ext}",
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.entertainment"
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Network"
    }
  }
}
